<?xml version="1.0" encoding="utf-8"?>
<LinearLayout xmlns:android="http://schemas.android.com/apk/res/android"
    android:layout_width="match_parent"
    android:layout_height="match_parent"
    android:orientation="vertical"
    android:background="@color/bg_dark"
    android:padding="10dp">

    <TextView
        android:layout_width="wrap_content"
        android:layout_height="wrap_content"
        android:text="@string/pgpt_title"
        android:textColor="@color/text_primary"
        android:textSize="18sp"
        android:textStyle="bold" />

    <TextView
        android:id="@+id/tvPgptStatus"
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:textColor="@color/text_secondary"
        android:textSize="12sp"
        android:layout_marginBottom="6dp" />

    <EditText
        android:id="@+id/etSearchPartition"
        android:layout_width="match_parent"
        android:layout_height="40dp"
        android:hint="Cari partisi (boot_a, nvram, …)"
        android:inputType="text"
        android:imeOptions="actionSearch"
        android:singleLine="true"
        android:textColor="@color/text_primary"
        android:textColorHint="@color/text_secondary"
        android:textSize="13sp"
        android:paddingStart="10dp"
        android:paddingEnd="10dp"
        android:background="@color/card_bg"
        android:layout_marginBottom="6dp" />

    <!-- Mode: Backup | Write | Scatter -->
    <LinearLayout
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:orientation="horizontal"
        android:layout_marginBottom="6dp">

        <Button
            android:id="@+id/btnModeBackup"
            android:layout_width="0dp"
            android:layout_height="36dp"
            android:layout_weight="1"
            android:layout_marginEnd="3dp"
            android:text="Backup"
            android:textSize="12sp" />

        <Button
            android:id="@+id/btnModeWrite"
            android:layout_width="0dp"
            android:layout_height="36dp"
            android:layout_weight="1"
            android:layout_marginStart="3dp"
            android:layout_marginEnd="3dp"
            android:text="Write"
            android:textSize="12sp" />

        <Button
            android:id="@+id/btnModeScatter"
            android:layout_width="0dp"
            android:layout_height="36dp"
            android:layout_weight="1"
            android:layout_marginStart="3dp"
            android:text="Scatter"
            android:textSize="12sp" />
    </LinearLayout>

    <!-- Device actions -->
    <LinearLayout
        android:id="@+id/rowDeviceActions"
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:orientation="horizontal"
        android:layout_marginBottom="6dp">

        <Button
            android:id="@+id/btnRefreshTable"
            android:layout_width="0dp"
            android:layout_height="36dp"
            android:layout_weight="1"
            android:layout_marginEnd="3dp"
            android:text="Baca tabel"
            android:textSize="11sp" />

        <Button
            android:id="@+id/btnSelectAll"
            android:layout_width="0dp"
            android:layout_height="36dp"
            android:layout_weight="1"
            android:layout_marginStart="3dp"
            android:layout_marginEnd="3dp"
            android:text="Select All"
            android:textSize="11sp" />

        <Button
            android:id="@+id/btnUnselectAll"
            android:layout_width="0dp"
            android:layout_height="36dp"
            android:layout_weight="1"
            android:layout_marginStart="3dp"
            android:layout_marginEnd="3dp"
            android:text="Unselect"
            android:textSize="11sp" />

        <Button
            android:id="@+id/btnRunAction"
            android:layout_width="0dp"
            android:layout_height="36dp"
            android:layout_weight="1"
            android:layout_marginStart="3dp"
            android:text="Backup"
            android:textSize="11sp" />
    </LinearLayout>

    <!-- Scatter-only: load scatter button (hidden in backup/write) -->
    <Button
        android:id="@+id/btnFullFlash"
        android:layout_width="match_parent"
        android:layout_height="36dp"
        android:text="Muat Scatter + folder FW"
        android:textSize="12sp"
        android:visibility="gone"
        android:layout_marginBottom="6dp" />

    <TextView
        android:id="@+id/tvBackupPath"
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:textColor="@color/text_secondary"
        android:textSize="11sp"
        android:layout_marginBottom="4dp" />

    <ListView
        android:id="@+id/lvPgptPartitions"
        android:layout_width="match_parent"
        android:layout_height="0dp"
        android:layout_weight="1"
        android:background="@color/card_bg"
        android:layout_marginBottom="6dp" />

    <ProgressBar
        android:id="@+id/progressBar"
        style="?android:attr/progressBarStyleHorizontal"
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:max="100"
        android:visibility="gone" />

    <TextView
        android:id="@+id/tvProgressLabel"
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:textColor="@color/text_secondary"
        android:textSize="12sp"
        android:visibility="gone" />
</LinearLayout>
